# Crossref
CROSSREF_API_URL=https://api.crossref.org/works
CROSSREF_MAILTO=
CROSSREF_USER_AGENT=literature-system/0.1
CROSSREF_KEYWORD=machine learning
CROSSREF_ROWS_PER_PAGE=100
CROSSREF_MAX_PAGES=10
CROSSREF_SLEEP_BETWEEN=1
CROSSREF_START_DATE=
CROSSREF_END_DATE=

# Semantic Scholar
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_RATE_LIMIT=1000

# MinerU (PDF解析)
MINERU_API_KEY=
MINERU_API_URL=https://mineru.net/api/v4/extract/task
MINERU_MAX_RETRIES=5
MINERU_UPLOAD_TIMEOUT=120
MINERU_TASK_POLL_INTERVAL=10
MINERU_TASK_MAX_WAIT=600
MINERU_DAILY_QUOTA=200

# Web of Science API (Clarivate，需要机构订阅 + API Key)
WOS_API_KEY=
WOS_API_URL=https://api.clarivate.com/apis/wos
WOS_USER_AGENT=literature-system/0.1 (Academic Research)
WOS_SLEEP_BETWEEN=1

# Scopus API (用于论文检索与作者画像补全；支持多 Key 逗号分隔)
SCOPUS_API_KEYS=
SCOPUS_INSTTOKEN=
SCOPUS_SLEEP_BETWEEN=1

# PDF 下载策略优先级（数字越小优先级越高，0表示禁用）
PDF_STRATEGY_CROSSREF_TEXT_MINING=1
PDF_STRATEGY_CROSSREF_PDF=2
PDF_STRATEGY_OA_URL=3
PDF_STRATEGY_DOI_REDIRECT=4
PDF_STRATEGY_UNPAYWALL=5

# PDF 解析策略优先级（数字越小优先级越高，0表示禁用）
PDF_PARSER_MINERU_API=1
PDF_PARSER_PYMUPDF=2
PDF_PARSER_MARKER_GPU=3
PDF_PARSER_MARKER_CPU=4

# Storage
RAW_JSON_DIR=data
CHECKPOINT_DIR=data/checkpoints

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=literature
DB_SSLMODE=prefer
SQLITE_PATH=db/literature.db

# Web UI / API Server
SEARCH_API_PORT=8088
FRONTEND_DIR=frontend

# 可视化配置（可选）
GRAPH_MAX_NODES=500

# PDF 下载配置
# 是否启用 scansci-pdf 多源桥接（true/false）
PDF_ENABLE_SCISCI=false

# 白名单来源，逗号分隔；不在列表中的来源不会启用
# 可选：oa_url, unpaywall, openalex_oa, openalex_content, core, europepmc, pmc,
#       semanticscholar, arxiv, publishers
PDF_SOURCE_WHITELIST=oa_url,unpaywall,openalex_oa,core,europepmc,pmc,semanticscholar,arxiv,publishers

# 单个来源连接/读取超时（秒）
PDF_SOURCE_CONNECT_TIMEOUT=10
PDF_SOURCE_READ_TIMEOUT=20

# Tier 1 并发数
PDF_TIER1_WORKERS=5

# 外部 API Keys（供 OpenAlex Content API、CORE 等使用）
OPENALEX_API_KEY=
CORE_API_KEY=

# 网络代理（部分下载来源可用）
NETWORK_PROXY=

# Logging
LOG_LEVEL=INFO

# ============================================================
# 第三阶段：LLM 知识提炼配置
# ============================================================
# LLM 提取器（七牛云 OpenAI 兼容接口 + DeepSeek 模型）
LLM_API_KEY=
LLM_BASE_URL=https://api.qnaigc.com/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_SLEEP_BETWEEN=1

# Embedding（硅基流动 + Qwen3-Embedding-4B）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIM=2560
EMBEDDING_BATCH_SIZE=32

# 向量检索（sqlite-vec 扩展）
VECTOR_SEARCH_TOP_K=10
SQLITE_VEC_EXTENSION_PATH=

# Phase3 提取参数
PHASE3_PROMPT_VERSION=v1
PHASE3_MAX_CLAIMS=5
PHASE3_AUDIT_ENABLED=true
